# Настоящие значения пишутся в .env рядом с config.yaml; файл исключён из Git.
# Приоритет: переменные процесса > .env > YAML. enabled задаётся в YAML.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
VK_ACCESS_TOKEN=
VK_SEARCH_TOKEN=
# VK_TOKEN — совместимый alias VK_ACCESS_TOKEN.
OPENROUTER_API_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SPREADSHEET_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# several recipients (Telegram user ids, separated by commas): TELEGRAM_CHAT_IDS=111111,222222
PROFI_MAIL_PASSWORD=
PROFI_MAIL_OAUTH_CLIENT_ID=
