# Секреты — реальные ключи никогда не должны попадать в git.
# Держи их только локально/на сервере, передавай через scp, а не через git.
config.yaml
service_account.json
.env
*.session
*.session-journal

# Виртуальное окружение и кэши — создаются заново на каждой машине.
venv/
__pycache__/
*.pyc

# Локальное состояние (файл уже виденных лидов) — своё на каждой машине,
# незачем таскать через git.
seen_leads.json

# Результаты discovery-скриптов — это черновики для ручного отбора,
# не часть кода.
vk_candidates.csv
telegram_candidates.csv
