# Секреты — реальные ключи никогда не должны попадать в git.
# Держи их только локально/на сервере, передавай через scp, а не через git.
config.yaml
service_account.json
.env
*.session
*.session-journal

# Виртуальное окружение и кэши — создаются заново на каждой машине.
venv/
__pycache__/
*.pyc

# Локальное состояние (файл уже виденных лидов) — своё на каждой машине,
# незачем таскать через git.
seen_leads.json

# Результаты discovery-скриптов — это черновики для ручного отбора,
# не часть кода.
vk_candidates.csv
telegram_candidates.csv

# Токены VK, бэкап конфига и лог cron — локальное состояние/секреты.
vk_tokens.json
config.yaml.save
cron.log

# Private state, atomic replacement files, local environments and reports.
vk_pkce_state.json
*.tmp
.*.tmp
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.lock
!uv.lock
.data/
.venv/
.pytest_cache/
.ruff_cache/
reports/
*.log
dist/
/release.tar.gz
build/
*.egg-info/

*.session-wal
*.session-shm
*_tokens.json
*pkce_state.json
