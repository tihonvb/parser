[Unit]
Description=Lead parser web panel, tracking and Telegram callbacks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parser
Group=parser
WorkingDirectory=/opt/parser/current
ExecCondition=/opt/parser/current/.venv/bin/lead-parser web --config /var/lib/parser/config.yaml --check-enabled
ExecStart=/opt/parser/current/.venv/bin/lead-parser web --config /var/lib/parser/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/parser
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
